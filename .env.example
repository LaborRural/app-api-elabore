# URL base da API (somente servidor; nunca exposta ao navegador)
API_BASE_URL=https://torta.tec.br/laborrural
# Caminho do login na API (POST {email,password} -> {access_token,...})
API_LOGIN_PATH=/login

# Supabase lr-analytics-db (somente servidor) - telas de Indicadores
SUPABASE_URL=https://<projeto>.supabase.co
SUPABASE_SERVICE_KEY=<service_role_key>

# SharePoint (Microsoft Graph, app registration) - planilhas completas do lr-indicadores-elabore
TENANT_ID=<tenant_id>
CLIENT_ID=<client_id>
CLIENT_SECRET=<client_secret>
SHAREPOINT_HOSTNAME=laborruralserv.sharepoint.com
# Quem baixa a planilha completa (vírgula; "@dominio" libera o domínio)
EMAILS_EQUIPE_LR=@laborrural.com
# Segredo para assinar o cookie de equipe: gere com  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<segredo_aleatorio>
